<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="x-drive">

    <!--chassis link-->
    <link name="chassis">
        <pose>0 0 0.05 0 0 0</pose> <!--5 cm above the ground-->

        <visual>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/chassis.dae</uri>
                </mesh>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/chassis.dae</uri>
                </mesh>
            </geometry>
        </collision>

        <inertial>
            <mass>1</mass>
            <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            </inertia>
        </inertial>
       
    </link>

    <link name="wheel_1">
        <visual>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </collision>

        <inertial>
            <mass>1</mass>
            <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            </inertia>
        </inertial>
    </link>

    <link name="wheel_2">
        <visual>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </collision>

        <inertial>
            <mass>1</mass>
            <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            </inertia>
        </inertial>
    </link>

    <link name="wheel_3">
    <pose>0 0 0 0 0 0</pose>
        <visual>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </collision>

        <inertial>
            <mass>1</mass>
            <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            </inertia>
        </inertial>
    </link>

    <link name="wheel_4">
        <visual>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <mesh>
                    <uri>model://x_drive/meshes/wheel.dae</uri>
                </mesh>
            </geometry>
        </collision>

        <inertial>
            <mass>1</mass>
            <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            </inertia>
        </inertial>
    </link>
   
    <joint name="chassis_2_w1" type="revolute">
        <parent>chassis</parent>
        <child>wheel_1</child>
        <pose relative_to='chassis'>0 0 0 0 0 0</pose>
    </joint>

    <joint name="chassis_2_w2" type="revolute">
        <parent>chassis</parent>
        <child>wheel_2</child>
        <pose relative_to='chassis'>0 0 0 0 0 0 </pose>
    </joint>

    <joint name="chassis_2_w3" type="revolute">
        <parent>chassis</parent>
        <child>wheel_3</child>
        <pose relative_to='chassis'> 0 0 0 0 0 0</pose>

    </joint>

    <joint name="chassis_2_w4" type="revolute">
        <parent>chassis</parent>
        <child>wheel_4</child>
        <pose relative_to='chassis'> 0 0 0 0 0 0</pose>
    
    </joint>

    <!-- locked postiton? -->
    <static>false</static>

     <joint name='' type='revolute'>
      <pose relative_to='link2'>0 0.1 0.9 0 -0 0</pose>
      <parent>link2</parent>
      <child>link3</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.7</damping>
          <friction>0.0</friction>          
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>