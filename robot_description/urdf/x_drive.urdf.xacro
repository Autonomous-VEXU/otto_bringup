<?xml version='1.0'?>
<robot name="x_drive" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <static>false</static>

    <!-- properties-->
    <xacro:property name="model_path" value="package://robot_description/models"/>
    <xacro:property name="package_path" value="package://robot_gazebo/config"/>
    <xacro:property name="wheel_offs" value="0.14"/>
    <xacro:property name="wheel_rad" value="0.0349253"/>
    <xacro:property name="wheel_width" value="0.02159"/>
    
    <!--world link-->
    <link name='base_footprint'/>

    <!--base_link link-->
    <link name="base_link">
        <visual>

            <origin xyz="0 0 0.05" rpy="0 0 0"/>

            <geometry>  
                <box size='0.20 0.20 0.02'/>
            </geometry>

            <material name="pink">
                <color rgba="0.93 0.28 0.60 1.0"/> 
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                 <box size='0.20 0.20 0.02'/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="4.54"/>
           <inertia
                ixx="0.05487"
                ixy="0.0"
                ixz="0.0"
                iyy="0.05487"
                iyz="0.0"
                izz="0.10974"/>
            </inertial>
    </link>

    <!--Sensor links-->
    <link name="imu_link"/>

    <!-- wheels -->
    <xacro:macro name="wheel_link" params="name">
        <link name="${name}">
            <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius='${wheel_rad}' length='${wheel_width}' />
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>

            <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius='${wheel_rad}' length='${wheel_width}' />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.070"/>
                <inertia
                ixx="0.001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001"
                iyz="0.0"
                izz="0.001"/>
            </inertial>
        </link>

    </xacro:macro>

    <xacro:wheel_link name="wheel_a"/>
    <xacro:wheel_link name="wheel_b"/>
    <xacro:wheel_link name="wheel_c"/>
    <xacro:wheel_link name="wheel_d"/>

    <!-- joints -->
    <joint name="footprint_2_link" type='fixed'>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <parent link='base_footprint'/>
        <child link='base_link'/>
    </joint>

    <joint name="chassis_to_wheel_a" type="continuous">
        <origin xyz="-${wheel_offs} ${wheel_offs} ${wheel_rad}" rpy="0 0 ${pi/4}"/>
        <parent link="base_link"/>
        <child link="wheel_a"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="chassis_to_wheel_b" type="continuous">
        <origin xyz="${wheel_offs} -${wheel_offs} ${wheel_rad}" rpy="0 0 ${-3* (pi/4)}"/>
        <parent link="base_link"/>
        <child link="wheel_b"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="chassis_to_wheel_c" type="continuous">
        <origin xyz="${wheel_offs} ${wheel_offs} ${wheel_rad}" rpy="0 0 -${pi/4}"/>
        <parent link="base_link"/>
        <child link="wheel_c"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="chassis_to_wheel_d" type="continuous">
        <origin xyz="-${wheel_offs} -${wheel_offs} ${wheel_rad}" rpy="0 0 ${3 *(pi/4)}"/>
        <parent link="base_link"/>
        <child link="wheel_d"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <!--Sensor Joints-->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </joint>

    <xacro:macro name='TiMXXS_lidar' params='sensor_number xyz yaw'>
        <!-- lidar link -->
        <link name="laser_frame_${sensor_number}"> <!-- make sure TiM7xxS has the same frame ID in the lidar launch file!-->
            <visual>
                <origin xyz="0 0 0.0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="0.02"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="0.02"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" />
                <mass value="0.114" />
                <inertia 
                ixx="0.001" 
                ixy="0.0" 
                ixz="0.0" 
                iyy="0.001"
                iyz="0.0" 
                izz="0.001"/>
            </inertial>
        </link>

        <!-- lidar joint -->
        <joint name="laser_joint_${sensor_number}" type="fixed">
            <parent link="base_link"/>
            <child link="laser_frame_${sensor_number}"/>
            <origin xyz="${xyz}" rpy="0 0 ${yaw}"/> 
        </joint>

    </xacro:macro>

    <xacro:TiMXXS_lidar sensor_number='1' xyz="0.13 0.12 0.14" yaw='-${pi/4}'/>
    <xacro:TiMXXS_lidar sensor_number='2' xyz="-0.13 0.12 0.14" yaw='${pi/4}'/> 

    <!-- ROS 2 Control-->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>mock_components/GenericSystem</plugin>
			<param name="mock_sensor_commands">false</param>
            <param name="state_following_offset">0.0</param>
        </hardware>
        <joint name="chassis_to_wheel_a">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="chassis_to_wheel_b">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="chassis_to_wheel_c">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="chassis_to_wheel_d">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
         </joint>
    </ros2_control>

</robot>